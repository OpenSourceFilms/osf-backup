{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/venvs/rtfm/bin/python3.11 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rtfm_sync.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/venvs/rtfm/bin/python3.11 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rtfm_stop_sync.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/venvs/rtfm/bin/python3.11 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rtfm_posttool_sync.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
